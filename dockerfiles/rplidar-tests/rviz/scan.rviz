Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
    - Class: rviz/Axes
      Name: Lidar (red = scan 0 deg, the box is opposite)
      Enabled: true
      Length: 0.5
      Radius: 0.03
      Reference Frame: <Fixed Frame>
    - Class: rviz/LaserScan
      Name: /scan
      Enabled: true
      Topic: /scan
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 85; 0
      Decay Time: 0
      Queue Size: 10
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: laser_link
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 80
      X: 0
      Y: 0
      Angle: 1.5708
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 800
  Width: 1100
